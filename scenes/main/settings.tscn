[sub_resource type="GDScript" id=11]
script/source = "extends ColorRect

func _input(event):
	if visible and event is InputEventKey:
		visible = false
		var control = ConfigFile.new() # Cоздать объект класса парсера конфиг-файлов
		control.load(\"res://scripts/settings.ini\")
		control.set_value(\"Controls\", G.keybind, event)
		control.save(\"res://scripts/settings.ini\")
"

