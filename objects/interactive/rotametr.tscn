[sub_resource type="GDScript" id=8]
script/source = "extends Spatial

func _ready():
	G.connect(\"waterflow\", self, \"refresh\")

# range 0-600 L/H
func refresh(_state, level): 
	$Flow.text = String(level * 6 * 1000 / 60) + \" ml/min\"
	$AnimationPlayer.play(\"flow\")
	$Pivot.translation.z = -1.2 -0.0015 * (level * 6)
	if level == 0:
		stop()
	
func stop():
	$AnimationPlayer.play(\"RESET\")
"

