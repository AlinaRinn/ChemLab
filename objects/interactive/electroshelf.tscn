[sub_resource type="GDScript" id=4]
script/source = "extends StaticBody

var active = false

func open():
	if !active:
		active = true
		$AnimationPlayer.play(\"open\")
	else:
		active = false
		$AnimationPlayer.play_backwards(\"open\")
"

