script/source = "extends Spatial

export(float) var channel1
export(float) var channel2
export(int) var channelNum
export(float) var progressBar

func _ready():
	$Viewport/Control/ProgressBar.value = progressBar
	$Temperature1.text = String(channel1)
	$Temperature2.text = String(channel2)
	$Channel.text = String(channelNum)

# Активый баг движка годот - Sprite3D должен быть после Viewport (есть в оф беклоге)
"

